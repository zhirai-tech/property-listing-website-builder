{
  "name": "lightweight-property-listing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "轻量化房源管理与一键房源网站生成平台 — 一次录入，生成可分享的房源展示页",
  "author": "ZHIRAI <xtang3125@gmail.com> (https://zhirai.cloud)",
  "homepage": "https://zhirai.cloud",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.ts",
    "migrate": "node --disable-warning=ExperimentalWarning src/db/migrate.ts",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.ts",
    "reminders": "node --disable-warning=ExperimentalWarning scripts/run-reminders.ts",
    "smoke": "node --disable-warning=ExperimentalWarning scripts/smoke.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "test:watch": "node --disable-warning=ExperimentalWarning --test --watch \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "expire-projects": "node --disable-warning=ExperimentalWarning scripts/expire-projects.ts",
    "walkthrough": "node --disable-warning=ExperimentalWarning scripts/walkthrough.ts",
    "verify": "node --disable-warning=ExperimentalWarning scripts/verify.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.4.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "typescript": "^5.8.3"
  }
}
