# ============================================================
# 轻量化房源管理与一键房源网站生成平台 — 环境变量示例
# ============================================================
# 使用方式：复制为 .env 后填入真实值。
# 安全要求（方案第六章第 8 条 / 第八章第 1 条）：
#   1. 密钥只允许通过环境变量或数据库加密配置注入；
#   2. 严禁把真实密钥写入前端代码或提交进仓库；
#   3. .env 已在 .gitignore 中排除。
# ============================================================

# ---- 运行环境 ----
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# 公开访问本站使用的根地址（用于生成分享链接与二维码）
# 生产环境必须改为真实域名，例如 https://listings.example.com
PUBLIC_BASE_URL=http://127.0.0.1:3000

# ---- 数据与存储位置 ----
DATA_DIR=./var
DATABASE_FILE=./var/db/app.sqlite
UPLOAD_DIR=./var/uploads
BACKUP_DIR=./var/backups

# ---- 管理模式鉴权 ----
# 后台管理口令。生产环境必须修改为强口令。
ADMIN_PASSWORD=change-me-in-production
# 会话签名密钥，至少 32 字符。
# 生成方式：node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=please-generate-a-long-random-session-secret-32chars

# ---- 默认工作区 ----
DEFAULT_WORKSPACE_NAME=我的房源工作区
# 工作区所有者邮箱（用于接收发布提醒）
OWNER_EMAIL=owner@example.com
DEFAULT_LOCALE=zh-CN
DEFAULT_CURRENCY=CNY
DEFAULT_AREA_UNIT=square_meter
DEFAULT_TIMEZONE=Asia/Shanghai

# ---- 上限校验（上传与配额）----
MAX_UPLOAD_BYTES=15728640
MAX_PHOTOS_PER_PROPERTY=30
MAX_VIDEO_BYTES=209715200

# ---- 外部服务适配层 ----
# 地图：osm = OpenStreetMap 免密钥瓦片（默认）；disabled = 完全关闭地图
MAP_PROVIDER=osm
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
# 若改用商业地图服务，在此填写密钥；留空表示不使用商业服务
MAP_API_KEY=
# 免费额度提示（方案第三章第 6 条要求上线前明确）
MAP_FREE_TIER_NOTE=OSM 公共瓦片服务免费但存在使用量限制，商用前请阅读其使用政策
# 周边信息（交通/商店/学校）查询端点，Overpass 兼容。可按地区替换为自建实例。
MAP_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# 存储：local = 本地磁盘；memory = 内存（仅测试）
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# 邮件：console = 仅打印到服务端日志；smtp = 真实投递
MAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

# 托管：default = 平台默认发布地址；custom_domain = 支持子域名/自定义域名
HOSTING_PROVIDER=default
# 自定义域名绑定的 CNAME 目标
HOSTING_CNAME_TARGET=listings.example.com
# 域名所有权验证使用的前缀（TXT 记录：<prefix>=<token>）
DOMAIN_VERIFY_PREFIX=_property-listing-verify

# ---- 提醒规则（方案第三章第 9 条）----
REMINDER_DAY_1=7
REMINDER_DAY_2=15
REMINDER_MAX_ATTEMPTS=3
REMINDER_DISPATCH_INTERVAL_MINUTES=60
# 提醒收件邮箱；留空则使用 OWNER_EMAIL
REMINDER_RECIPIENT=

# ---- 对外状态判定 ----
# 超过多少天未更新房源，展示页就把状态标为「未确认」；0 表示关闭该机制
LISTING_STALE_DAYS=30

# ---- 备份 ----
BACKUP_RETENTION_DAYS=30